# Routes — Viewer Service
# This file defines all application routes (Higher priority routes first)

# Health Check
GET  /health                            @controllers.viewer.ViewController.health(request: play.mvc.Http.Request)

# Granular view lifecycle APIs
POST /v1/view/start                     @controllers.viewer.ViewController.viewStart(request: play.mvc.Http.Request)
POST /v1/view/update                    @controllers.viewer.ViewController.viewUpdate(request: play.mvc.Http.Request)
POST /v1/view/end                       @controllers.viewer.ViewController.viewEnd(request: play.mvc.Http.Request)

# Recompute roll-up (admin/ops) — mirrors legacy /v1/activity/agg, targets the aggregator
POST /v1/view/agg                       @controllers.viewer.ViewAggregateController.agg(request: play.mvc.Http.Request)

# Read + summary APIs
POST   /v1/view/read                    @controllers.viewer.ViewController.viewRead(request: play.mvc.Http.Request)
POST   /v1/assessment/submit            @controllers.viewer.ViewController.assessmentSubmit(request: play.mvc.Http.Request)
POST   /v1/assessment/read              @controllers.viewer.ViewController.assessmentRead(request: play.mvc.Http.Request)
POST   /v1/summary/read                 @controllers.viewer.ViewSummaryController.summaryRead(request: play.mvc.Http.Request)
GET    /v1/summary/list/:userId         @controllers.viewer.ViewSummaryController.summaryList(userId: String, request: play.mvc.Http.Request)
GET    /v1/summary/download/:userId     @controllers.viewer.ViewSummaryController.summaryDownload(userId: String, request: play.mvc.Http.Request)
DELETE /v1/summary/delete/:userId       @controllers.viewer.ViewSummaryController.summaryDelete(userId: String, request: play.mvc.Http.Request)

# Competency framework APIs
POST   /v1/competency/passbook/read         @controllers.viewer.CompetencyController.passbookRead(request: play.mvc.Http.Request)
POST   /v1/competency/gap/read              @controllers.viewer.CompetencyController.gapRead(request: play.mvc.Http.Request)
POST   /v1/competency/recommend             @controllers.viewer.CompetencyController.recommend(request: play.mvc.Http.Request)
POST   /v1/competency/position/update       @controllers.viewer.CompetencyController.positionUpdate(request: play.mvc.Http.Request)
GET    /v1/competency/framework/read/:frameworkId   @controllers.viewer.CompetencyController.frameworkRead(frameworkId: String, request: play.mvc.Http.Request)

# Competency admin APIs (gateway-restricted, same convention as the other /private routes)
POST   /private/v1/competency/position/update    @controllers.viewer.CompetencyController.privatePositionUpdate(request: play.mvc.Http.Request)
POST   /private/v1/competency/evidence/import    @controllers.viewer.CompetencyController.evidenceImport(request: play.mvc.Http.Request)
POST   /private/v1/competency/evidence/revoke    @controllers.viewer.CompetencyController.evidenceRevoke(request: play.mvc.Http.Request)
POST   /private/v1/competency/reproject          @controllers.viewer.CompetencyController.reproject(request: play.mvc.Http.Request)
POST   /private/v1/competency/cache/invalidate   @controllers.viewer.CompetencyController.cacheInvalidate(request: play.mvc.Http.Request)
POST   /private/v1/competency/expiry/sweep       @controllers.viewer.CompetencyController.expirySweep(request: play.mvc.Http.Request)
