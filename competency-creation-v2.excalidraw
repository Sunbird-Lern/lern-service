   "roundness": null,
   "seed": 46,
   "version": 1,
   "versionNonce": 46,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Steps 3 and 4 are the same engine behind three front-ends \u2014 workbook, YAML in git, and an LLM draft from the source document. All three emit the one spec.\nApply is idempotent and resumable: re-running it against an unchanged spec writes nothing. It refuses code renames and never deletes a term.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Steps 3 and 4 are the same engine behind three front-ends \u2014 workbook, YAML in git, and an LLM draft from the source document. All three emit the one spec.\nApply is idempotent and resumable: re-running it against an unchanged spec writes nothing. It refuses code renames and never deletes a term.",
   "lineHeight": 1.25
  }
 ],
